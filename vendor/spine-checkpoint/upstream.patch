+        next_attempt: u64,
+        next_commit: u64,
+    ) -> Result<String, String> {
+        serde_json::to_string(&CheckpointRef {
+            schema: CHECKPOINT_SCHEMA,
+            planner,
+            next_attempt,
+            next_commit,
+        })
+        .map_err(|error| error.to_string())
+    }
+
+    /// Restore an authenticated cache derived from the matching host log.
+    /// The host owns log-prefix validation and handles full replay on a miss.
+    pub fn import_checkpoint(
+        state: &str,
+        thread: &ThreadNamespace,
+        config: &SpineConfig,
+    ) -> Result<Self, String> {
+        let checkpoint: Checkpoint =
+            serde_json::from_str(state).map_err(|error| error.to_string())?;
+        if checkpoint.schema != CHECKPOINT_SCHEMA {
+            return Err("checkpoint schema does not match this core build".to_string());
+        }
+        if !checkpoint.planner.validate_checkpoint(thread, config) {
+            return Err(
+                "checkpoint does not match the runtime namespace, configuration or boundary"
+                    .to_string(),
+            );
+        }
+        Ok(Self::from_replay(
+            checkpoint.planner,
+            checkpoint.next_attempt,
+            checkpoint.next_commit,
+        ))
+    }
