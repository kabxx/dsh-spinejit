+// JSON cannot directly represent a map whose keys are NodeId vectors.
+mod checkpoint_arrivals {
+    use super::{BTreeMap, NodeId, SpawnArrival};
+    use serde::{Deserialize, Deserializer, Serialize, Serializer};
+
+    pub fn serialize<S: Serializer>(map: &BTreeMap<NodeId, SpawnArrival>, serializer: S) -> Result<S::Ok, S::Error> {
+        map.iter().collect::<Vec<_>>().serialize(serializer)
+    }
+
+    pub fn deserialize<'de, D: Deserializer<'de>>(deserializer: D) -> Result<BTreeMap<NodeId, SpawnArrival>, D::Error> {
+        let pairs = Vec::<(NodeId, SpawnArrival)>::deserialize(deserializer)?;
+        let mut map = BTreeMap::new();
+        for (node, arrival) in pairs {
+            if node != arrival.producer || map.insert(node, arrival).is_some() {
+                return Err(serde::de::Error::custom("invalid checkpoint arrival entry"));
+            }
+        }
+        Ok(map)
+    }
+}
