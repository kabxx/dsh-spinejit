+    /// Export the established state at a settled transaction boundary.
+    pub fn export_checkpoint(&self) -> Result<String, String> {
+        if !matches!(self.state, SamplingRuntimeState::Idle) {
+            return Err("checkpoint requires an idle sampling runtime".to_string());
+        }
+        Self::encode_checkpoint(&self.planner, self.next_attempt, self.next_commit)
+    }
+
+    /// Return the state immediately before an untouched sampling started.
+    /// The host can replay the logged sampling in a fresh runtime without
+    /// advancing or sealing the live runtime.
+    pub fn export_pre_sampling_checkpoint(&self) -> Result<String, String> {
+        let SamplingRuntimeState::Active(active) = &self.state else {
+            return Err("pre-sampling checkpoint requires an active sampling".to_string());
+        };
+        if !active.started || active.next_execution != 0 || !active.pending.is_empty() {
+            return Err(
+                "pre-sampling checkpoint requires a sampling without executions".to_string(),
+            );
+        }
+        let planner = self
+            .planner
+            .checkpoint_before_attempt(&active.attempt_id, &active.pre_boundary)
+            .ok_or_else(|| "pre-sampling checkpoint requires unchanged sources".to_string())?;
+        let next_attempt = self
+            .next_attempt
+            .checked_sub(1)
+            .filter(|_| self.next_attempt != u64::MAX)
+            .ok_or_else(|| {
+                "pre-sampling checkpoint cannot recover the attempt ordinal".to_string()
+            })?;
+        Self::encode_checkpoint(&planner, next_attempt, self.next_commit)
+    }
